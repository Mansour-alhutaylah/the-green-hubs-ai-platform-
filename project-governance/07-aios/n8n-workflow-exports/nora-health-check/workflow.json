      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json;\nconst envelope = input.envelope || {};\nconst actor = envelope.actor || {};\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;\nconst emptyInput = JSON.stringify(envelope.input === undefined ? {} : envelope.input) === '{}';\nconst valid = input.parsed === true && envelope.contract_version === '1.0' && envelope.workflow === 'nora.health_check' && uuid.test(String(envelope.request_id || '')) && uuid.test(String(envelope.correlation_id || '')) && uuid.test(String(actor.user_id || '')) && uuid.test(String(actor.organization_id || '')) && envelope.request_id === input.request_id_header && emptyInput;\nreturn [{ json: { contract_valid: valid, category: valid ? null : 'contract_invalid', request_id: valid ? envelope.request_id : null, correlation_id: valid ? envelope.correlation_id : null, started_at: input.started_at } }];"
      }
