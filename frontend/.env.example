# Copy to .env.local (gitignored) and adjust as needed.
# Never commit real values here, and never put a Supabase service-role key
# in any frontend env var — only the public anon key belongs in the browser.

# Shows a secondary "Enter Demo Workspace" action on the Login page that
# creates a local mock session (Admin demo user) with no email, password,
# OTP, Supabase Auth call, backend call, or JWT. Dev-server only — Vite
# statically replaces import.meta.env.DEV with false in production builds,
# so this flag has no effect there regardless of its value. Demo mode does
# not require any of the Supabase/API variables below to be set.
VITE_DEV_AUTH_BYPASS=true

# Base URL of the backend API (FastAPI), no trailing slash — e.g.
# http://localhost:8000. Required for live login, workspace/engagement
# loading, and the Documents/Upload pages.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL — e.g. https://xxxxx.supabase.co. Required for live
# (non-demo) authentication.
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe for the browser. Never the
# service-role key.
VITE_SUPABASE_ANON_KEY=
