# Copy this file to `.env` and fill in real values. Never commit `.env`.

ENVIRONMENT=development
DEBUG=true
APP_NAME=the-green-hubs-ai-platform
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Database (Supabase Postgres, pgvector-enabled).
# Format: postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/green_hubs

# Supabase project (not yet consumed by any code this sprint).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

JWT_ALGORITHM=HS256

# OpenAI (not yet consumed by any code this sprint).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
