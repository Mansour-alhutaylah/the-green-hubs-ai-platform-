      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first();\nconst received = (item.json && item.json.headers) || {};\nconst headers = {};\nconst names = Object.keys(received);\nfor (let index = 0; index < names.length; index++) { const value = received[names[index]]; headers[names[index].toLowerCase()] = value === undefined || value === null ? '' : String(value); }\nconst binary = item.binary || {};\nconst property = binary.data || binary.body;\nif (!property || typeof property.data !== 'string') { throw new Error('Raw body capture is not enabled on the Webhook node. Enable options.rawBody. Re-serialising the parsed body would produce a different digest and break signature verification.'); }\nreturn [{ json: { workflow: 'nora.health_check', key_id: headers['x-gh-aios-key-id'] || '', timestamp: headers['x-gh-aios-timestamp'] || '', request_id: headers['x-gh-request-id'] || '', signature: headers['x-gh-aios-signature'] || '', correlation_id: headers['x-correlation-id'] || '', body_base64: property.data, started_at: $now.toISO() } }];"
