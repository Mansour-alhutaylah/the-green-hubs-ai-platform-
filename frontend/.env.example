# Copy to .env.local (gitignored) and adjust as needed.
# Never commit real values here, and never put a Supabase service-role key
# in any frontend env var — only the public anon key belongs in the browser.

# --- Data source (Live vs Preview) ---------------------------------------
# The application runs in Live mode unless BOTH variables below are exactly
# "preview". A blank, misspelled, mis-cased, or inconsistent pair fails
# closed to Live, so a Production build can never fall into Preview by
# omission or by one mistyped value. Nothing at runtime — no query
# parameter, cookie, storage entry, header, or tenant selection — can change
# the mode. See src/lib/data/source.ts.
#
# Live mode is the default and needs neither variable set.
#
# VITE_APP_MODE=preview
# VITE_APP_ENVIRONMENT=preview

# Build classification. Leave empty (or set to "production") for a real
# deployment; "development" for local Live work against a local backend.
VITE_APP_ENVIRONMENT=

# Preview-only. Which state the Preview fixtures render:
# populated (default) | empty | loading | error | forbidden | partial.
# Ignored entirely in Live mode.
# VITE_PREVIEW_SCENARIO=populated

# --- Live services --------------------------------------------------------
# Preview mode contacts none of these: it makes no network call at all, so
# a Preview build needs no Supabase or API configuration.

# Base URL of the backend API (FastAPI), no trailing slash — e.g.
# http://localhost:8000. Required in Live mode for sign-in, workspace and
# engagement loading, and the Documents/Upload pages.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL — e.g. https://xxxxx.supabase.co. Required for Live
# authentication.
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe for the browser. Never the
# service-role key.
VITE_SUPABASE_ANON_KEY=
