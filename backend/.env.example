# Copy this file to `.env` and fill in real values. Never commit `.env`.

ENVIRONMENT=development
DEBUG=true
APP_NAME=the-green-hubs-ai-platform
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Database (Supabase Postgres, pgvector-enabled).
# Format: postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/green_hubs

# Supabase project (not yet consumed by any code this sprint).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Pre-provisioned Supabase Storage bucket name (bucket must already exist).
SUPABASE_STORAGE_BUCKET=documents

JWT_ALGORITHM=HS256

# AI provider. Two mutually exclusive ways to configure embeddings and
# chat/completion, both via the same OpenAI-compatible request shape:
#
# 1) Direct OpenAI (default) -- set OPENAI_API_KEY, leave OPENAI_BASE_URL
#    and OPENROUTER_API_KEY unset. Model names are OpenAI's own, e.g.
#    "text-embedding-3-small" / "gpt-4o-mini".
#
# 2) OpenRouter (https://openrouter.ai) -- leave OPENAI_API_KEY unset and
#    set OPENROUTER_API_KEY instead; OPENAI_BASE_URL then defaults to
#    OpenRouter's endpoint automatically. Model names must use
#    OpenRouter's vendor-prefixed form, e.g. "openai/text-embedding-3-small"
#    / "openai/gpt-4o-mini".
#
# OPENAI_BASE_URL only needs to be set explicitly to target some other
# OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=

# Embeddings. EMBEDDING_DIMENSION must stay 1536 -- the
# document_chunk_embeddings.embedding column is a fixed vector(1536).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

LOG_LEVEL=INFO
