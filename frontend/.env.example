# Copy to .env.local (gitignored) and adjust as needed.

# Shows a secondary "Enter Demo Workspace" action on the Login page that
# creates a local mock session (Admin demo user) with no email, password,
# OTP, Supabase Auth call, backend call, or JWT. Dev-server only — Vite
# statically replaces import.meta.env.DEV with false in production builds,
# so this flag has no effect there regardless of its value.
VITE_DEV_AUTH_BYPASS=true
