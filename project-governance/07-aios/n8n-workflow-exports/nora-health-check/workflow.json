        "jsCode": "const captured = $('Capture Raw Request').first().json;\nconst decoded = Buffer.from(captured.body_base64, 'base64').toString('utf8');\nconst parsed = (function () { try { return JSON.parse(decoded); } catch (error) { return null; } })();\nconst isObject = parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed);\nreturn [{ json: { envelope: isObject ? parsed : {}, parsed: isObject, request_id_header: captured.request_id, started_at: captured.started_at } }];"
      }
